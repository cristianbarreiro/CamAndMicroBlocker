<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CamMicBlocker</RootNamespace>
    <AssemblyName>CamMicBlocker</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Camera and Microphone Blocker for Windows</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamMicBlocker.Elevated\CamMicBlocker.Elevated.csproj" />
  </ItemGroup>

  <!-- Copy Elevated Helper EXE to OutDir on normal Build -->
  <Target Name="BuildElevatedHelper" AfterTargets="Build" Condition="'$(PublishDir)' == ''">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\CamMicBlocker.Elevated\CamMicBlocker.Elevated.csproj&quot; -c $(Configuration) -o &quot;$(OutDir)&quot;" />
  </Target>

  <!-- Publish & Copy Elevated Helper EXE alongside CamMicBlocker.exe on Publish -->
  <Target Name="PublishElevatedHelper" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\CamMicBlocker.Elevated\CamMicBlocker.Elevated.csproj&quot; -c $(Configuration) -r win-x64 --self-contained -p:PublishSingleFile=true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\CamMicBlocker.Elevated\bin\$(Configuration)\net10.0-windows\win-x64\publish\CamMicBlocker.Elevated.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
